# ---------------------------------------------------------------------------
# Wazuh Server API (management plane) — required
# ---------------------------------------------------------------------------
WAZUH_API_URL=https://wazuh.example.com:55000
WAZUH_API_USER=wazuh-mcp
WAZUH_API_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Wazuh Indexer (alerts and vulnerabilities) — optional but needed for hunting
# Without it, alert search, aggregations, timelines and vulnerability tools
# are unavailable. Credentials default to the API ones if omitted.
# ---------------------------------------------------------------------------
WAZUH_INDEXER_URL=https://wazuh.example.com:9200
WAZUH_INDEXER_USER=wazuh-mcp
WAZUH_INDEXER_PASSWORD=change-me

# ---------------------------------------------------------------------------
# TLS. Wazuh ships self-signed certificates, so a first run usually needs
# either verification off or a CA bundle. Prefer the CA bundle in production.
# WAZUH_VERIFY_SSL applies to both components; the per-component variables
# override it.
# ---------------------------------------------------------------------------
WAZUH_VERIFY_SSL=false
# WAZUH_CA_BUNDLE=/etc/ssl/certs/wazuh-root-ca.pem
# WAZUH_API_VERIFY_SSL=true
# WAZUH_INDEXER_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Index patterns. Change only if this deployment renamed them.
# ---------------------------------------------------------------------------
# WAZUH_ALERTS_INDEX=wazuh-alerts-*
# WAZUH_ARCHIVES_INDEX=wazuh-archives-*
# WAZUH_VULNERABILITIES_INDEX=wazuh-states-vulnerabilities-*

# ---------------------------------------------------------------------------
# Active Response. Off by default: these tools change production hosts.
# When off, they are not registered at all, so the model cannot call them.
# The allowlist further restricts which commands are permitted; leave it
# empty to allow any command configured on the manager.
#
# The API user also needs the `active-response:command` RBAC policy — the
# `readonly` role does not include it.
# ---------------------------------------------------------------------------
WAZUH_ALLOW_ACTIVE_RESPONSE=false
# WAZUH_ACTIVE_RESPONSE_COMMANDS=firewall-drop,host-deny

# ---------------------------------------------------------------------------
# Context budget: the hard cap on items any single tool call may return.
# ---------------------------------------------------------------------------
# WAZUH_MAX_RESULTS=500

# ---------------------------------------------------------------------------
# Transport: stdio (default), sse, or streamable-http.
#
# stdio ignores the host/port settings below — the client owns the process and
# there is no socket. They apply only to the HTTP transports.
#
# The bind address stays on loopback on purpose: this server has no
# authentication of its own, so binding it to 0.0.0.0 hands the whole SIEM to
# anyone who can reach the port. Put a proxy that authenticates in front of it,
# or reach it through an SSH tunnel.
# ---------------------------------------------------------------------------
# WAZUH_MCP_TRANSPORT=stdio
# WAZUH_MCP_HOST=127.0.0.1
# WAZUH_MCP_PORT=8000
# WAZUH_MCP_PATH=/mcp
